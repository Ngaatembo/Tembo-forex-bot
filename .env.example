# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Not a secret -- controls which origins the browser permits, no
# credentials involved. Add your real Vercel URL here once deployed,
# e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_trading

# --- Market data provider ---
# mock | oanda | ig | fxcm | interactive_brokers
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_ACCOUNT_ID=

# --- News provider ---
# mock | finnhub
NEWS_PROVIDER=mock
NEWS_API_KEY=

# --- Economic calendar provider ---
# mock | finnhub
# Finnhub's free tier uses the SAME API key for news and the economic
# calendar (one account, one key) -- if you're using Finnhub for both,
# NEWS_API_KEY and ECONOMIC_CALENDAR_API_KEY can be set to the same value.
ECONOMIC_CALENDAR_PROVIDER=mock
ECONOMIC_CALENDAR_API_KEY=

# --- AI provider ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Risk / safety ---
# Hard safety switch — leave false until Phase 10. Even then this alone
# does nothing without a real broker adapter implementation.
ENABLE_LIVE_EXECUTION=false

MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_DRAWDOWN_PCT=10.0
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=10.0

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# --- Auth ---
SECRET_KEY=replace-with-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
